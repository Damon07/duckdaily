---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="zh-CN">
<title>{{ site.title | xml_escape }}</title><subtitle>{{ site.description | xml_escape }}</subtitle><link href="{{ '/' | absolute_url | xml_escape }}"/><link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self"/><id>{{ '/' | absolute_url | xml_escape }}</id><updated>{{ site.time | date_to_xmlschema }}</updated><author><name>DuckDaily</name></author>
{% for post in site.posts limit: 30 %}<entry><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url | xml_escape }}"/><id>{{ post.url | absolute_url | xml_escape }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{{ post.updated_at | default: post.date | date_to_xmlschema }}</updated><summary>{{ post.description | default: post.excerpt | strip_html | xml_escape }}</summary><content type="html">{{ post.content | xml_escape }}</content></entry>{% endfor %}
</feed>
